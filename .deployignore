# Defense-in-depth only. Preferred deploy source is the generated payload:
#   node scripts/build-frontend-publish.mjs
#   icp_diff_assets canister=mprew-viaaa-aaaah-quola-cai source_dir=.deploy/frontend-public
# Do not deploy this project root directly; the broad ignores below reduce blast radius
# if someone accidentally points an asset upload at the root.

